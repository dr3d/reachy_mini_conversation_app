LOCAL_BRIDGE_HOST=127.0.0.1
LOCAL_BRIDGE_PORT=8765

# LM Studio is used for the language-model turn.
LOCAL_BRIDGE_LLM_PROVIDER=lmstudio

# LM Studio, OpenAI-compatible endpoint. Include /v1.
LOCAL_BRIDGE_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_BRIDGE_LMSTUDIO_MODEL=

# Strip emoji from TTS and map common assistant emoji to play_emotion tool calls.
LOCAL_BRIDGE_EMOJI_EMOTIONS=1

# Command must print transcript to stdout. Use {wav}.
# LOCAL_BRIDGE_STT_MODEL=small.en
# LOCAL_BRIDGE_STT_PROVIDER=faster_whisper
# LOCAL_BRIDGE_STT_DEVICE=auto
# LOCAL_BRIDGE_STT_COMPUTE_TYPE=default
# LOCAL_BRIDGE_STT_LANGUAGE=en
# LOCAL_BRIDGE_STT_BEAM_SIZE=1
# LOCAL_BRIDGE_STT_BEST_OF=1
# LOCAL_BRIDGE_STT_HOTWORDS=Reachy Mini Eric chassis eyes ESP32 Piper LM Studio
# LOCAL_BRIDGE_STT_INITIAL_PROMPT=Reachy Mini robot conversation about Eric, chassis, eyes, ESP32, Piper, and LM Studio.
# LOCAL_BRIDGE_STT_COMMAND=python stt_faster_whisper.py --audio "{wav}"
# LOCAL_BRIDGE_VAD_RMS=700
# LOCAL_BRIDGE_VAD_STOP_MS=450

# Command must write a WAV file. Use {text} and {wav}.
# LOCAL_BRIDGE_TTS_COMMAND=python speak.py --text "{text}" --out "{wav}"

# Native Piper support avoids command-line quoting issues for TTS text.
# LOCAL_BRIDGE_TTS_PROVIDER=piper
# LOCAL_BRIDGE_PIPER_EXE=local_voice_bridge/piper/piper/piper.exe
# LOCAL_BRIDGE_PIPER_MODEL=local_voice_bridge/piper/voices/en_US-lessac-high.onnx

# Native Kokoro support. Download kokoro-v1.0.onnx and voices-v1.0.bin into local_voice_bridge/kokoro/.
# LOCAL_BRIDGE_TTS_PROVIDER=kokoro
# LOCAL_BRIDGE_KOKORO_MODEL=local_voice_bridge/kokoro/kokoro-v1.0.onnx
# LOCAL_BRIDGE_KOKORO_VOICES=local_voice_bridge/kokoro/voices-v1.0.bin
# LOCAL_BRIDGE_KOKORO_VOICE=am_eric
# LOCAL_BRIDGE_KOKORO_SPEED=1.0
# LOCAL_BRIDGE_KOKORO_LANG=en-us
# LOCAL_BRIDGE_KOKORO_TTS_CHUNK_CHARS=480

# Qwen3-TTS HTTP support. Start local_qwen3_tts_server first.
# LOCAL_BRIDGE_TTS_PROVIDER=qwen3tts
# LOCAL_BRIDGE_QWEN_TTS_URL=http://192.168.0.150:8000/v1/audio/speech
# LOCAL_BRIDGE_QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# LOCAL_BRIDGE_QWEN_TTS_VOICE=Aiden
# LOCAL_BRIDGE_QWEN_TTS_LANGUAGE=English
# LOCAL_BRIDGE_QWEN_TTS_TIMEOUT_S=60
# LOCAL_BRIDGE_MAX_SPOKEN_CHARS=220
# LOCAL_BRIDGE_QWEN_TTS_CHUNK_CHARS=80
# LOCAL_BRIDGE_AUDIO_DELTA_PACE=0.85
# LOCAL_BRIDGE_WS_PING_INTERVAL_S=60
# LOCAL_BRIDGE_WS_PING_TIMEOUT_S=60
