# Copy to .env and adjust for the machine that should run the LLM.
JETSON_REALTIME_OLLAMA_URL=http://192.168.0.150:11434
JETSON_REALTIME_OLLAMA_MODEL=qwen3.6:27b
JETSON_REALTIME_HOST=0.0.0.0
JETSON_REALTIME_PORT=8765
JETSON_REALTIME_OLLAMA_TIMEOUT_S=180
JETSON_REALTIME_OLLAMA_NUM_PREDICT=64
JETSON_REALTIME_OLLAMA_THINK=0

# Qwen3-TTS HTTP provider. Leave as none until the RTX-side TTS server is running.
JETSON_REALTIME_TTS_PROVIDER=none
JETSON_REALTIME_QWEN_TTS_URL=http://192.168.0.150:8000/v1/audio/speech
JETSON_REALTIME_QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
JETSON_REALTIME_QWEN_TTS_VOICE=Aiden
